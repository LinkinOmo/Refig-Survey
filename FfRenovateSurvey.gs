// Layout files are PRIVATE (user's choice 2026-11-16: open inside the app only). Link sharing is removed from every matched
// file, so a forwarded Drive link no longer opens; the web app (executeAs USER_DEPLOYING = file owner) still reads them and
// streams a file only to users allowed for that store (getFfrLayoutFile). Explicit per-person shares are not touched.
// Done once per file (ids in a script property). FFR_LAYOUT_UNSHARE = old copies outside the Layout folder that were
// link-shared before the folder change.
var FFR_LAYOUT_UNSHARE = ['1vpyNZGnbbVr-jSE0fgSA-lKvLa5JycpQ', '12QkB7ABdt0er2VN3lktCF3FapuhxU-VM'];   // root 112_Suratthani / 227_Ranong
function _ffrMakePrivate_(files) {
    var props = PropertiesService.getScriptProperties(), done = {}, changed = false;
    try { (JSON.parse(props.getProperty('FFR_LAYOUT_PRIVATE_V1') || '[]')).forEach(function(id) { done[id] = 1; }); } catch (e) {}
    var list = files.slice();
    FFR_LAYOUT_UNSHARE.forEach(function(id) { if (!done[id]) { try { list.push(DriveApp.getFileById(id)); } catch (e) {} } });
    list.forEach(function(f) {
        var id = f.getId();
        if (done[id]) return;
        try {
            if (f.getSharingAccess() !== DriveApp.Access.PRIVATE) f.setSharing(DriveApp.Access.PRIVATE, DriveApp.Permission.NONE);
            done[id] = 1; changed = true;
        } catch (e) { Logger.log('FFR private ' + f.getName() + ': ' + e); }
    });
    if (changed) try { props.setProperty('FFR_LAYOUT_PRIVATE_V1', JSON.stringify(Object.keys(done))); } catch (e2) {}
