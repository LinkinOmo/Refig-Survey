function _ffrLayoutGold_(fileName, byGold, byOracle, golds, byName) {
    var m = String(fileName).match(/^\s*(\d{3,6})(?=[\s_\-.])/);
    if (m) {
        var d = m[1];
        if (d.length === 6) return byOracle[d] || '';
        if (d.length === 5) return byGold[d] ? d : '';
        if (d.length === 3) { var hit = golds.filter(function(g) { return g.slice(-3) === d; }); return hit.length === 1 ? hit[0] : ''; }
        return '';
