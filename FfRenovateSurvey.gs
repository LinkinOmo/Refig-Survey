            ctrl: p.ctrl === 'ปกติ' || p.ctrl === 'ผิดปกติ' ? p.ctrl : '', spare: p.spare === 'มี' || p.spare === 'ไม่มี' || p.spare === 'ไม่ทราบ' ? p.spare : '',
            rep: _ffrInt_(p.rep), repCost: _ffrNum_(p.repCost), rec: _ffrPick_(p.rec, FFR_RACK_REC), asset: _ffrTxt_(p.asset, 160), wo: _ffrPick_(p.wo, FFR_WO),
            // spare capacity — can this multiset feed the new Remote cabinets (Hybrid rule: Remote only where the multiset is kept)
            spareHp: p.spareHp === '' || p.spareHp == null ? '' : _ffrNum_(p.spareHp), spareCirc: p.spareCirc === '' || p.spareCirc == null ? '' : _ffrInt_(p.spareCirc),
