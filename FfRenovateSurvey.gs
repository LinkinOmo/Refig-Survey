// kind: 'To-Be' (Final Layout) / 'As-Is' from the sub-folder name; sorted To-Be first, newest first.
function _ffrLayoutMap_(force) {
    var cache = CacheService.getScriptCache();
    if (!force) { var hit = cache.get(FFR_LAYOUT_CACHE); if (hit) { try { return JSON.parse(hit); } catch (e) {} } }
    var byGold = {}, byOracle = {}, golds = [], byName = {};
    FFR_STORES.forEach(function(s) { byGold[s.c] = 1; byOracle[s.o] = s.c; golds.push(s.c); byName[_ffrNorm_(s.n)] = s.c; });
    var out = {}, matched = [];
    var add = function(gold, o) { (out[gold] || (out[gold] = [])).push(o); };
    var scan = function(folder, kind, depth) {
        var it = folder.getFiles();
        while (it.hasNext()) {
            var f = it.next(), name = f.getName();
            if (!/\.(pdf|png|jpe?g)$/i.test(name)) continue;   // in-app viewer: PDF + images
            var gold = _ffrLayoutGold_(name, byGold, byOracle, golds, byName);
            if (!gold) continue;
            matched.push(f);
            add(gold, { name: name, fid: f.getId(), kind: kind,
                        at: Utilities.formatDate(f.getLastUpdated(), 'Asia/Bangkok', 'yyyy-MM-dd') });
        }
        if (depth >= 3) return;
        var subs = folder.getFolders();
        while (subs.hasNext()) {
            var sub = subs.next(), sn = sub.getName();
            if (FFR_LAYOUT_SKIP_DIRS.test(sn)) continue;
            var k = /to.?be/i.test(sn) ? 'To-Be' : /as.?is/i.test(sn) ? 'As-Is' : kind;
            scan(sub, k, depth + 1);
        }
    };
    try { scan(DriveApp.getFolderById(FFR_LAYOUT_FOLDER_ID), '', 0); } catch (e) { Logger.log('FF Renovate layout folder: ' + e); }
    try { _ffrMakePrivate_(matched); } catch (eV) { Logger.log('FFR private: ' + eV); }
    try {
        var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(FFR_LAYOUT_SHEET);
        if (sh && sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, 4).getValues().forEach(function(r) {
            var gold = String(r[0] || '').trim(), url = String(r[2] || '').trim();
            if (byGold[gold] && /^https:\/\//.test(url)) add(gold, { name: String(r[1] || 'Layout'), url: url, kind: 'Link', at: r[3] instanceof Date ? Utilities.formatDate(r[3], 'Asia/Bangkok', 'yyyy-MM-dd') : '' });
        });
    } catch (e2) {}
    var rank = { 'To-Be': 0, 'Link': 1, 'As-Is': 2, '': 3 };
    Object.keys(out).forEach(function(g) { out[g].sort(function(a, b) { return (rank[a.kind] - rank[b.kind]) || (a.at < b.at ? 1 : a.at > b.at ? -1 : 0); }); });
    try { cache.put(FFR_LAYOUT_CACHE, JSON.stringify(out), 1800); } catch (e3) {}
    return out;
}
