function _ffrNorm_(s) {
    return String(s || '').toLowerCase().replace(/\.(pdf|png|jpe?g|dwg)$/, '').replace(/\(.*?\)/g, '')
        .replace(/\b(as is|new|all new|tourist|frozen|horeca)\b/g, '').replace(/[0-9]{2}[-_][0-9]{2}[-_][0-9]{2}/g, '').replace(/[^a-z0-9]/g, '');
