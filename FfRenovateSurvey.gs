        FFR_ITEMS.forEach(function(x, i) {
            var n = _ffrTxt_(x[1], 160), c = _ffrTxt_(x[0], 40);
            _FFR_ITEM_BY_NAME.full[c + '|' + n] = i;
            _FFR_ITEM_BY_NAME.name[n] = _FFR_ITEM_BY_NAME.name[n] === undefined ? i : -2;   // -2 = ambiguous
        });
    }
    var n = _ffrTxt_(name, 160), k = _ffrTxt_(cat, 40) + '|' + n;
    if (_FFR_ITEM_BY_NAME.full[k] !== undefined) return _FFR_ITEM_BY_NAME.full[k];
    var j = _FFR_ITEM_BY_NAME.name[n];
    return j !== undefined && j > -1 ? j : -1;
}
