function _ffrNum_(v) { var n = parseFloat(v); return isNaN(n) || n < 0 ? 0 : Math.round(n * 100) / 100; }
function _ffrInt_(v) { var n = parseInt(v, 10); return isNaN(n) || n < 0 ? 0 : n; }
function _ffrTemp_(v) { if (v === '' || v == null) return ''; var n = parseFloat(v); return isNaN(n) || n < -60 || n > 80 ? '' : Math.round(n * 10) / 10; }
function _ffrTxt_(v, m) { return String(v == null ? '' : v).replace(/[\r\n\t]+/g, ' ').trim().substring(0, m || 120); }
function _ffrPick_(v, list) { return list.indexOf(v) > -1 ? v : ''; }
function _ffrPickK_(v, pairs) { for (var i = 0; i < pairs.length; i++) if (pairs[i][0] === String(v)) return pairs[i][0]; return ''; }
function _ffrYear_(v) { var n = parseInt(v, 10); return isNaN(n) || n < 1980 || n > new Date().getFullYear() + 1 ? '' : n; }

// ─── Store master (from the BOQ) ──────────────────────────────────────────────
// → { oracle: { c gold, o oracle, n, t team, m model, lv, age, area, rack: BOQ has a new Multiset, lines: [...] } }
function _ffrStoreIndex_() {
    var out = {};
    FFR_STORES.forEach(function(s) {
        var lines = s.L.map(function(l) {
            var it = FFR_ITEMS[l[0]];
            return { bx: l[0], cat: it[0], name: it[1], kind: it[2], pr: it[3], pn: it[4], ec: it[5] || '', ref: l[1], nw: l[2] };
        });
        out[s.o] = { c: s.c, o: s.o, n: s.n, t: s.t, m: /^[SML]$/.test(s.m) ? s.m : '', lv: s.lv, age: s.age, area: s.area, go: s.go,
                     rack: lines.some(function(l) { return l.kind === 'rack' && l.nw > 0; }), lines: lines };
    });
    return out;
}
function _ffrIsCab_(kind) { return kind === 'plug' || kind === 'remote'; }
function _ffrStoreSummary_(st) {
    var s = { refQ: 0, newQ: 0, refB: 0, newB: 0, sysB: 0, plugQ: 0, remoteQ: 0, rackQ: 0 };
    st.lines.forEach(function(l) {
        if (_ffrIsCab_(l.kind)) {
            s.refQ += l.ref; s.newQ += l.nw; s.refB += l.ref * l.pr; s.newB += l.nw * l.pn;
            s[l.kind === 'plug' ? 'plugQ' : 'remoteQ'] += l.ref + l.nw;
        } else { s.sysB += l.ref * l.pr + l.nw * l.pn; if (l.kind === 'rack') s.rackQ += l.nw; }
    });
    s.total = s.refB + s.newB + s.sysB;
    return s;
}
// Store list for the form's picker (small: no BOQ lines).
function getFfrStoreList_() {
    var idx = _ffrStoreIndex_();
    return Object.keys(idx).map(function(o) {
        var st = idx[o], s = _ffrStoreSummary_(st);
        return { code: st.o, gold: st.c, name: st.n, team: st.t, model: st.m, rack: st.rack, refQ: s.refQ, newQ: s.newQ, full: FFR_FULL_RENO.indexOf(st.o) > -1 };
    });
}

