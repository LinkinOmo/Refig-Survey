// Cabinet group: q units of the same BOQ line. Result split qRef + qWork + qNew + qNone must equal q
// (K.Dean's final list: Refurbish / Workable / Request new). plan = what the BOQ assumed (ref | new | '').
function _ffrParseItems_(raw) {
    var arr = raw;
    if (typeof raw === 'string') { try { arr = JSON.parse(raw); } catch (e) { arr = []; } }
    if (!Array.isArray(arr)) arr = [];
    return arr.slice(0, 150).map(function(p, i) {
        var q = Math.min(Math.max(_ffrInt_(p.q), 1), 500);
        var bx = parseInt(p.bx, 10); if (isNaN(bx) || !FFR_ITEMS[bx]) bx = -1;
        // Stable identity across BOQ revisions: a card carries its cabinet name as well as the FFR_ITEMS index.
        // If the name no longer matches that index (the BOQ list moved), find the type by name; if the type left the
        // BOQ, keep the saved name with no index (no price) — never silently relabel a card as a different cabinet.
        var pName = _ffrTxt_(p.name, 160);
        if (bx > -1 && pName && _ffrTxt_(FFR_ITEMS[bx][1], 160) !== pName) bx = _ffrItemByName_(p.cat, pName);
        // purchasing code (FF_Equipment_Codes.xlsx) — same code = same purchase item even if the BOQ renamed it
        var pEc = _ffrTxt_(p.ec, 20).toUpperCase();
        if (bx === -1 && pEc) { for (var j = FFR_ITEMS.length - 1; j >= 0; j--) if (FFR_ITEMS[j][5] === pEc) { bx = j; break; } }
        var it = {
            iid: _ffrTxt_(p.iid, 10) || ('C' + (i + 1)), bx: bx,
            cat: bx > -1 ? FFR_ITEMS[bx][0] : (_ffrPick_(p.cat, FFR_CATS) || _ffrTxt_(p.cat, 40) || 'อื่นๆ'),
            name: bx > -1 ? FFR_ITEMS[bx][1] : pName,
            ec: bx > -1 ? (FFR_ITEMS[bx][5] || '') : pEc,
            sys: _ffrPickK_(p.sys, FFR_SYS) || (bx > -1 ? FFR_ITEMS[bx][2] : 'plug'),
            pos: _ffrPick_(p.pos, FFR_POS), plan: p.plan === 'ref' || p.plan === 'new' ? p.plan : '', q: q,
            yr: _ffrYear_(p.yr), brand: _ffrTxt_(p.brand, 60), tm: _ffrTemp_(p.tm),
            body: _ffrPickK_(p.body, FFR_GRADE), cool: _ffrPickK_(p.cool, FFR_GRADE), door: _ffrPickK_(p.door, FFR_GRADE),
            rep: _ffrInt_(p.rep), repCost: _ffrNum_(p.repCost),
            qRef: _ffrInt_(p.qRef), qWork: _ffrInt_(p.qWork), qNew: _ffrInt_(p.qNew), qNone: _ffrInt_(p.qNone),
            eq: _ffrEqIds_(p.eq),
            why: _ffrPick_(p.why, FFR_WHY), asset: _ffrTxt_(p.asset, 160), wo: _ffrPick_(p.wo, FFR_WO), nt: _ffrTxt_(p.nt, 300), pk: _ffrTxt_(p.pk, 60)
        };
        var left = q;
        ['qRef', 'qWork', 'qNew', 'qNone'].forEach(function(k) { it[k] = Math.min(it[k], left); left -= it[k]; });
        return it;
    });
}
// Optional Equipment IDs on a cabinet card (the Hyper Ref / Fresh Food equipment QR IDs, e.g. 111128-LF03):
// split on , ; space · upper-case · de-duplicated · max 60 IDs of ≤ 30 chars → "111128-LF03, 111128-LF04".
function _ffrEqIds_(v) {
    var seen = {}, out = [];
    String(v == null ? '' : v).toUpperCase().split(/[\s,;]+/).forEach(function(x) {
        x = x.replace(/[^A-Z0-9\-_.\/]/g, '').substring(0, 30);
        if (x && !seen[x] && out.length < 60) { seen[x] = 1; out.push(x); }
    });
    return out.join(', ');
}
// (category, name) → FFR_ITEMS index; name alone when it is unique. -1 = not in the current BOQ.
var _FFR_ITEM_BY_NAME = null;
function _ffrItemByName_(cat, name) {
    if (!_FFR_ITEM_BY_NAME) {
