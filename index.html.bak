    <!-- User Controls -->
    <div id="user-controls"
        class="hidden fixed top-4 right-4 z-[90] flex items-center gap-3 bg-white/90 backdrop-blur-sm p-2 px-4 rounded-full shadow-lg border border-gray-100 transition-all hover:shadow-xl">
        <div class="flex flex-col items-end">
            <span id="user-email-display" class="text-xs font-bold text-gray-700"></span>
            <span class="text-[10px] text-gray-500">Logged in</span>
