        <button onclick="toggleChangePwd(true)" class="text-gray-600 hover:text-blue-600 p-1" title="Change Password">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11.536 11 13 12.464l-4 4L7.5 15l-4 4m6-1a2 2 0 002-2" />
            </svg>
        </button>
        <button onclick="logout()" class="text-gray-600 hover:text-red-600 p-1" title="Logout">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
        </button>
    </div>


    <script>
        // Auth Logic
        const AUTH_KEY = 'app_auth_token';
        const AUTH_USER = 'app_user_data';
        let CURRENT_USER = null;

        // Check Login on Load
        (function checkAuth() {
            const user = localStorage.getItem(AUTH_USER);
            if (user) {
                try {
                    CURRENT_USER = JSON.parse(user);
                    updateUserUI(CURRENT_USER);
                    document.getElementById('auth-overlay').classList.add('hidden');
                    document.getElementById('user-controls').classList.remove('hidden');
                } catch (e) {
                    console.error("Auth Error", e);
                    logout();
                }
            } else {
                // Show login
                document.getElementById('auth-overlay').classList.remove('hidden');
                document.getElementById('user-controls').classList.add('hidden');
            }
        })();

        function updateUserUI(user) {
            const display = document.getElementById('user-email-display');
            if (display) display.textContent = user.name || user.email;
        }

        function handleLogin(e) {
            e.preventDefault();

            const btn = document.getElementById('loginBtn');
            const spinner = document.getElementById('loginSpinner');
            const errorMsg = document.getElementById('loginError');
            const email = document.getElementById('loginEmail').value;
            const pwd = document.getElementById('loginPassword').value;

            // UI Loading
            btn.disabled = true;
            spinner.classList.remove('hidden');
            errorMsg.classList.add('hidden');

            google.script.run
                .withSuccessHandler(function (res) {
                    btn.disabled = false;
                    spinner.classList.add('hidden');

                    if (res.success) {
                        // Save Session
                        localStorage.setItem(AUTH_USER, JSON.stringify(res.user));
                        localStorage.setItem(AUTH_KEY, 'valid');

                        CURRENT_USER = res.user;
                        updateUserUI(CURRENT_USER);

                        // Hide Overlay, Show Controls
                        document.getElementById('auth-overlay').classList.add('hidden');
                        document.getElementById('user-controls').classList.remove('hidden');

                        // Check Admin Status immediately
                        google.script.run.withSuccessHandler(handleAdminStatus).checkAdminStatus(CURRENT_USER.email);
                    } else {
                        errorMsg.textContent = res.error;
                        errorMsg.classList.remove('hidden');
                    }
                })
                .withFailureHandler(function (err) {
                    btn.disabled = false;
                    spinner.classList.add('hidden');
                    errorMsg.textContent = "System Error: " + err;
                    errorMsg.classList.remove('hidden');
                })
                .loginUser(email, pwd);
        }

        function logout() {
            localStorage.removeItem(AUTH_USER);
            localStorage.removeItem(AUTH_KEY);
            location.reload();
        }

        // Allow Global Access (if needed by other scripts)
        window.logout = logout;
        window.checkAuth = checkAuth; // in case we need to re-verify

        // Change Password Logic
        function toggleChangePwd(show) {
            const modal = document.getElementById('change-pwd-modal');
            if (show) {
                modal.classList.remove('hidden');
                document.getElementById('changePwdError').classList.add('hidden');
                document.getElementById('oldPwd').value = '';
                document.getElementById('newPwd').value = '';
                document.getElementById('confirmPwd').value = '';
            } else {
                modal.classList.add('hidden');
            }
        }

        function handleChangePwd(e) {
            e.preventDefault();

            const oldPwd = document.getElementById('oldPwd').value;
            const newPwd = document.getElementById('newPwd').value;
            const confirmPwd = document.getElementById('confirmPwd').value;
            const errorMsg = document.getElementById('changePwdError');
            const btn = document.getElementById('changePwdBtn');

            if (newPwd !== confirmPwd) {
                errorMsg.textContent = "New passwords do not match.";
                errorMsg.classList.remove('hidden');
                return;
            }

            if (!CURRENT_USER || !CURRENT_USER.email) {
                errorMsg.textContent = "Session invalid. Please logout and login again.";
                errorMsg.classList.remove('hidden');
                return;
            }

            btn.disabled = true;
            btn.textContent = "Updating...";

            google.script.run
                .withSuccessHandler(function (res) {
                    btn.disabled = false;
                    btn.textContent = "Update Password";

                    if (res.success) {
                        alert("Password changed successfully. Please login again.");
                        logout();
                    } else {
                        errorMsg.textContent = res.error;
                        errorMsg.classList.remove('hidden');
                    }
                })
                .withFailureHandler(function (err) {
                    btn.disabled = false;
                    btn.textContent = "Update Password";
                    errorMsg.textContent = "Error: " + err;
                    errorMsg.classList.remove('hidden');
                })
                .changePassword(CURRENT_USER.email, oldPwd, newPwd);
        }
    </script>

