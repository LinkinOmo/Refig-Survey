            <div class="text-center mb-6">
                <h2 class="text-2xl font-bold text-gray-800">Welcome Back</h2>
                <p class="text-gray-500">Please sign in to continue</p>
            </div>

            <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
