                    <label class="block text-xs font-medium text-gray-500 uppercase">Old Password</label>
                    <input type="password" id="oldPwd"
                        class="w-full border border-gray-300 p-2 rounded focus:ring-2 focus:ring-blue-500 outline-none"
                        required>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 uppercase">New Password</label>
                    <input type="password" id="newPwd"
                        class="w-full border border-gray-300 p-2 rounded focus:ring-2 focus:ring-blue-500 outline-none"
                        required>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 uppercase">Confirm New</label>
                    <input type="password" id="confirmPwd"
                        class="w-full border border-gray-300 p-2 rounded focus:ring-2 focus:ring-blue-500 outline-none"
