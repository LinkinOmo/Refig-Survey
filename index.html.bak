    <!-- Change Password Modal -->
    <div id="change-pwd-modal"
        class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 z-[110] flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl max-w-sm w-full p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-4">Change Password</h3>
            <form onsubmit="handleChangePwd(event)" class="space-y-4">
